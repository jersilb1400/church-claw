# ChurchClaw overlay environment
# Copy to .env.churchclaw and fill values

# Core providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional routers/gateways
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=

# Optional extra providers
GOOGLE_API_KEY=

# Optional local model support
OLLAMA_ENABLED=false

# Church integrations (examples)
ROCK_RMS_BASE_URL=
ROCK_RMS_API_KEY=
PLANNING_CENTER_APP_ID=
PLANNING_CENTER_SECRET=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
MONDAY_API_TOKEN=

# Teams bot channel (optional)
TEAMS_TENANT_ID=

# Security baseline
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret
