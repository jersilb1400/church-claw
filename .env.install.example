# ChurchClaw — copy to `.env` and use with docker-compose.install.yml
#   cp .env.install.example .env

# ─── Required secrets (install script can generate these) ───
POSTGRES_PASSWORD=change-this-strong-db-password
SECRET_KEY=change-this-app-secret
JWT_SECRET_KEY=change-this-jwt-secret

# ─── URL users type in the browser (scheme + host + port if not 80/443) ───
# After install, default UI: http://localhost:8080
CHURCHCLAW_PORT=8080
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# HTTPS in production: set real origin(s) and enable secure cookies
# CORS_ORIGINS=["https://church.example.org"]
# AUTH_COOKIE_SECURE=true

POSTGRES_USER=clawith
POSTGRES_DB=clawith

# Optional: pre-built images (skip --build). See docs/INSTALL_DOCKER.md
# BACKEND_IMAGE=ghcr.io/YOUR_ORG/churchclaw-backend:latest
# FRONTEND_IMAGE=ghcr.io/YOUR_ORG/churchclaw-frontend:latest

DOCKER_NETWORK=churchclaw_network
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_EXPOSE_ACCESS_TOKEN_IN_BODY=false
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
